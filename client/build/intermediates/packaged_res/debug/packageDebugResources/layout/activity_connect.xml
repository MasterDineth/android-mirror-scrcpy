<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1117"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connect_title"
            android:textColor="#F8FAFC"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="28dp"
            android:text="@string/connect_subtitle"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_host_ip"
            android:textColor="#CBD5E1"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/editHostIp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="#1E2433"
            android:hint="192.168.31.109"
            android:inputType="textNoSuggestions"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:text="192.168.31.109"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_port"
            android:textColor="#CBD5E1"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/editPort"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="#1E2433"
            android:hint="27183"
            android:inputType="number"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:text="27183"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_bitrate"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerBitrate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="#1E2433"
                    android:paddingHorizontal="10dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_fps"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerFps"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="#1E2433"
                    android:paddingHorizontal="10dp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#4F9CF9"
            android:text="@string/action_connect"
            android:textAllCaps="false"
            android:textColor="#0B1220"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
